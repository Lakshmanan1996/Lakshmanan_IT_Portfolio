# DO NOT commit a filled-in version of this to git.
# Copy this file to 01-secret.yaml, fill in real values, apply it, and make sure
# 01-secret.yaml is in your .gitignore.
#
# Quick way to create it instead of editing YAML by hand:
#   kubectl create secret generic backend-secrets \
#     --namespace=portfolio \
#     --from-literal=MONGODB_URI='mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority' \
#     --from-literal=ADMIN_API_KEY='<output of: openssl rand -hex 32>'

apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: portfolio
type: Opaque
stringData:
  MONGODB_URI: "mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority"
  ADMIN_API_KEY: "<generate with: openssl rand -hex 32>"
